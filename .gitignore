# ComfyDock —— 入库排除规则
# 行尾与编码基线见 .gitattributes / .editorconfig

# 编译产物（可重建）
bin/
obj/

# 运行时数据（含账号密钥，不入库）—— 只钉仓库根
/data/

# 发布产物（dotnet publish 落点）—— 只钉仓库根
/Web/

# 旧发布落点（v0.7 前，含旧映像与运行时数据）
/dist/

# 线上识别 / 生成产物落点
/out/

# 调试符号与上一版映像
*.pdb
*.old

# 本地配置与缓存
.vs/
*.user
CatTemp/

# Python 缓存（runtime/rvc 的推理代码随仓库走，但字节码不入库）
__pycache__/
*.pyc

# 推理运行时：irodori-tts 的克隆（外部仓库，不入库）
/runtime/irodori-tts/

# 注意：/runtime/rvc/ 是自持的 RVC 推理代码（rvc_lite 包），随软件入库——不要整体排除 runtime/

# 发布过程产物（exe 同级的运行时配套文件）——只入库 exe 本体
/ComfyDock.dll
/ComfyDock.deps.json
/ComfyDock.runtimeconfig.json
